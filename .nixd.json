{
  "nixd": {
    "nixpkgs": {
      "expr": "(builtins.getFlake (builtins.toString ./.)).darwinConfigurations.dumpedcore.pkgs"
    },
    "formatting": {
      "command": ["nixfmt"]
    },
    "options": {
      "nixos": {
        "expr": "(builtins.getFlake (builtins.toString ./.)).darwinConfigurations.dumpedcore.options"
      },
      "darwin": {
        "expr": "(builtins.getFlake (builtins.toString ./.)).darwinConfigurations.dumpedcore.options"
      },
      "home_manager": {
        "expr": "(builtins.getFlake (builtins.toString ./.)).darwinConfigurations.dumpedcore.options.home-manager.users.type.getSubOptions []"
      }
    }
  }
}
