terminal {
    font-family "Berkeley Mono"
    font-size 14
    font-thicken true
    scrollback-lines 200000000
    cursor-style "block"
    cursor-blink false
}

colors {
    background "#F4F0ED"
    foreground "#6B5C4D"

    palette 0="#867462"
    palette 1="#d7898c"
    palette 2="#659e69"
    palette 3="#cc7f2b"
    palette 4="#485f84"
    palette 5="#854882"
    palette 6="#436460"
    palette 7="#d4cbc3"
    palette 8="#a69582"
    palette 9="#c65333"
    palette 10="#83b887"
    palette 11="#c29830"
    palette 12="#abb9d6"
    palette 13="#be79bb"
    palette 14="#729893"
    palette 15="#FFFFFF"
}

window {
    padding-x 10
    opacity 1
    quit-after-last-window-closed true
}

clipboard {
    clipboard-read "ask"
    clipboard-write "ask"
    clipboard-trim-trailing-spaces true
    clipboard-paste-protection true
    clipboard-paste-bracketed-safe true
}

shell {
    shell-integration "fish"
    shell-integration-features "no-cursor"
}

titlebar {
    font-family "Berkeley Mono"
}

keytable "root" {
    bind "ctrl+b" action="switch-table" table="prefix"
    bind "ctrl+k" action="clear-screen"
}

keytable "prefix" {
    timeout ms=1500 action="pop"

    // Splits
    bind "minus" action="split" direction="down"
    bind "backslash" action="split" direction="right"

    // Pane management
    bind "x" action="close-pane"
    bind "z" action="zoom-pane"

    // Focus
    bind "h" action="focus-pane" direction="left"
    bind "j" action="focus-pane" direction="down"
    bind "k" action="focus-pane" direction="up"
    bind "l" action="focus-pane" direction="right"

    // Tabs
    bind "c" action="new-tab"
    bind "n" action="next-tab"
    bind "p" action="prev-tab"
    bind "1" action="goto-tab" index=0
    bind "2" action="goto-tab" index=1
    bind "3" action="goto-tab" index=2
    bind "4" action="goto-tab" index=3
    bind "5" action="goto-tab" index=4
    bind "6" action="goto-tab" index=5
    bind "7" action="goto-tab" index=6
    bind "8" action="goto-tab" index=7
    bind "9" action="goto-tab" index=8
    bind "shift+period" action="move-tab" direction="right"
    bind "shift+comma" action="move-tab" direction="left"

    // Search
    bind "slash" action="search"

    // Resize mode
    bind "r" action="switch-table" table="resize"

    bind "escape" action="pop"
}

keytable "resize" {
    timeout ms=3000 action="pop"
    stay true

    bind "h" action="resize-pane" direction="left" amount=2
    bind "j" action="resize-pane" direction="down" amount=2
    bind "k" action="resize-pane" direction="up" amount=2
    bind "l" action="resize-pane" direction="right" amount=2
    bind "=" action="equalize-panes"

    bind "enter" action="pop-all"
    bind "escape" action="pop-all"
}
