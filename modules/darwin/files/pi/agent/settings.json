{
  "theme": "light",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-astra",
  "defaultThinkingLevel": "high",
  "defaultTools": ["+codemode"],
  "packages": ["git:github.com/seruman/pi-things", "npm:@plannotator/pi-extension"],
  "npmCommand": ["bun"],
  "hideThinkingBlock": false,
  "cacheWarming": "idle",
  "compaction": {
    "enabled": true,
    "reserveTokens": 75000,
    "keepRecentTokens": 10000
  }
}
